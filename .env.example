# Root Environment Configuration Template for CreditLens

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development

# Backend Configuration
ENVIRONMENT=development
