# ==============================================================================
# CreditLens Full-Stack Docker Compose Environment Configuration Template
# Copy this file to .env before running `docker compose up`
# ==============================================================================

# PostgreSQL Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=creditlens
POSTGRES_PORT=5432

# Backend Service Settings
ENVIRONMENT=production
LOG_LEVEL=INFO
JWT_SECRET_KEY=replace_this_with_a_64_char_cryptographically_secure_random_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Gemini API Key (Optional for RAG knowledge synthesis)
GEMINI_API_KEY=

# Frontend Service Settings (Use /api/v1 for same-origin Docker Compose, or full cloud URL for decoupled hosting)
NEXT_PUBLIC_API_URL=/api/v1
