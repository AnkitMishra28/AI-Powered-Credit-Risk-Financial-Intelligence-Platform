# ==============================================================================
# CreditLens Frontend Environment Configuration Template
# Copy this file to .env.local for local development.
# ==============================================================================

# Backend API Base URL Configuration:
# 
# 1. Local Bare-Metal Development (FastAPI on :8000, Next.js on :3000):
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
#
# 2. Production Same-Origin / Reverse-Proxy / Docker Compose:
# NEXT_PUBLIC_API_URL=/api/v1
#
# 3. Production Decoupled Cloud (Vercel Frontend + Render Backend):
#    IMPORTANT: the value MUST include the trailing /api/v1 path segment, because
#    the FastAPI backend mounts every route under /api/v1. Pointing at the bare
#    host (https://<service>.onrender.com) makes every request 404.
# NEXT_PUBLIC_API_URL=https://ai-powered-credit-risk-financial.onrender.com/api/v1

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
