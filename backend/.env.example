# ==============================================================================
# CreditLens Backend Production Environment Configuration Template
# Copy this file to .env and supply genuine production credentials.
# ==============================================================================

# Application Environment (development | testing | staging | production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & JSON Web Token Configuration
# IN PRODUCTION: Generate a 64-character hex string using `openssl rand -hex 32`
JWT_SECRET_KEY=creditlens-development-secret-key-change-in-production-1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Allowed CORS Origins (Comma-separated or JSON list of frontend origins)
# Example: https://creditlens.yourdomain.com,http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL + pgvector)
# For local Docker: postgresql+asyncpg://postgres:postgrespassword@db:5432/creditlens
# For AWS RDS / Neon: postgresql+asyncpg://<user>:<password>@<host>:5432/<db>?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/creditlens
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=creditlens
POSTGRES_PORT=5432

# Google Gemini API Key (For grounded financial RAG synthesis)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Rate Limiting & Abuse Prevention
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MIN=15
RATE_LIMIT_COPILOT_PER_MIN=30
RATE_LIMIT_UPLOAD_PER_MIN=10
