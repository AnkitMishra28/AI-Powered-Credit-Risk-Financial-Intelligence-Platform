# CreditLens Backend Environment Variables
ENVIRONMENT=development
PROJECT_NAME="CreditLens API"
VERSION="1.0.0"

# PostgreSQL Database (Neon or Local PostgreSQL)
# Example: postgresql+asyncpg://user:password@ep-sample-123.region.aws.neon.tech/creditlens?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/creditlens

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Google Gemini API (Phase 2)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Secret Key for JWT / Session
SECRET_KEY=replace-with-a-very-secure-random-32-byte-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080
